# Linux counterpart of launchd/local.ft-to-kindle.plist. Install with the
# sed line in README ("Setting up on Linux"), which fills in the repo path.
[Unit]
Description=Deliver today's myFT edition to the Kindle

[Service]
Type=oneshot
# Creates ~/.local/state/ft-to-kindle for the log and the once-a-day stamp.
StateDirectory=ft-to-kindle
# Linux equivalent of caffeinate -is: stop a laptop suspending mid-run.
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --mode=block \
    --who=ft-to-kindle --why="Fetching myFT" \
    /bin/bash __FT2K_DIR__/run-local.sh
StandardOutput=append:%h/.local/state/ft-to-kindle/ft-to-kindle.log
StandardError=append:%h/.local/state/ft-to-kindle/ft-to-kindle.log
TimeoutStartSec=45min
