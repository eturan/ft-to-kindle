# ft-to-kindle configuration.
# Copy to ~/.config/ft-to-kindle/env and chmod 600 it - it stays outside
# the repo because every value here is private to you.

# Your personal myFT RSS feed (ft.com -> myFT -> Following -> RSS).
# The URL embeds a personal ID and works without login: treat it like a
# password.
MYFT_RSS_URL=https://www.ft.com/myft/following/<your-unique-id>.rss

# A python linked against OpenSSL 3.x (FT 403s older TLS stacks).
# Check with: python3 -c 'import ssl; print(ssl.OPENSSL_VERSION)'
FT_FETCH_PYTHON=/opt/homebrew/bin/python3

# Netscape-format ft.com cookies exported from a logged-in browser
# (required for full articles; without it premium articles are teasers).
FT_COOKIE_FILE=$HOME/.config/ft-to-kindle/ft-cookies.txt

# Exact serial of the Kindle that gets the paper - list yours with:
#   ~/.config/ft-to-kindle/stk-venv/bin/python recipes/stk_send.py devices
# Leave empty to send to every device on the Amazon account.
KINDLE_DEVICE_SERIAL=

# --- SMTP fallback (optional) ---------------------------------------
# Only used if the Send to Kindle registration (stk-client.json) is
# absent. Needs an app password and the sender allow-listed in Amazon's
# Personal Document Settings.
SMTP_USER=
SMTP_PASS=
KINDLE_EMAIL=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
