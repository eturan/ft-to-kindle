<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.ft-to-kindle</string>

    <!-- caffeinate keeps the Mac from falling back asleep mid-run: the
         07:00 slot usually fires during a DarkWake, and without an
         assertion the system re-sleeps within a minute, stalling TLS
         handshakes (empty/failed papers Aug 27-31 2026). -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-is</string>
        <string>/bin/bash</string>
        <string>__FT2K_DIR__/run-local.sh</string>
    </array>

    <!-- Hourly attempts 07:00-12:00 local time. A slot that fails (no
         network during DarkWake) is retried at the next one; the stamp
         file in run-local.sh keeps delivery to once per day. Slots missed
         while fully asleep coalesce into one run at wake. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <!-- Also try at login/reboot, so a morning that started powered-off
         still gets a paper. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__FT2K_HOME__/Library/Logs/ft-to-kindle.log</string>
    <key>StandardErrorPath</key>
    <string>__FT2K_HOME__/Library/Logs/ft-to-kindle.log</string>
</dict>
</plist>
